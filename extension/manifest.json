{
  "manifest_version": 3,
  "name": "URLguard — キリル文字ドメインをブロック",
  "version": "1.0.0",
  "minimum_chrome_version": "103",
  "description": "キリル文字を含むドメインへのページ移動を通信前に止めます。",
  "key": "",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "idn_gate",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "gate.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
